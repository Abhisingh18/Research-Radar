# Copy to .env for local testing (.env is gitignored — never commit real secrets).

# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model slug from https://openrouter.ai/models — Qwen, GLM (z-ai) and
# Nvidia Nemotron models all work well for this task.
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# Create a bot via @BotFather on Telegram, then message it once and hit
# https://api.telegram.org/bot<token>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp alerts via Twilio (https://www.twilio.com/docs/whatsap/sandbox).
# TWILIO_WHATSAPP_TO is YOUR phone number, with country code, e.g.
# "whatsapp:+91XXXXXXXXXX" — keep it here (gitignored), never in code.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=
